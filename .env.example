# NeX 4GB Rename Bot (@Nex_bots) Environment Variables Example

# Pyrogram API Credentials (Get from https://my.telegram.org)
API_ID=
API_HASH=

# Bot Token (Get from https://t.me/BotFather)
BOT_TOKEN=

# 4GB Premium Pyrogram Session String (Generate using any string session generator with Telegram Premium account)
STRING_SESSION=
# MongoDB Database Settings (Get from https://cloud.mongodb.com)
DB_URL=
DB_NAME=NeX_4GB_Rename_Bot

# Bot Administrators (User IDs separated by space)
ADMIN=

# Logging & Backup Channels (Must start with -100)
LOG_CHANNEL=
FILES_CHANNEL=

# Force Subscribe Channel Username without @ (Leave blank or Nex_bots)
FORCE_SUB=Nex_bots

# Personal Bot Mode (True = Only ADMIN can use, False = Public with FORCE_SUB)
OWNER_ONLY=True

# Webhook Service Configuration (True for hosting on Render/Koyeb/Heroku)
WEBHOOK=True

# Optional Start Message Photo URL
START_PIC=

